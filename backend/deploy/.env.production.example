APP_NAME="CIINLV POS"
APP_ENV=production
APP_KEY=replace-in-secret-manager
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://admin.example.com
APP_FORCE_HTTPS=true
TRUSTED_PROXIES=replace-with-load-balancer-addresses

DB_CONNECTION=pgsql
DB_HOST=private-postgres-host
DB_PORT=5432
DB_DATABASE=ciinlv_pos
DB_USERNAME=ciinlv_runtime
DB_PASSWORD=replace-in-secret-manager
DB_SSLMODE=verify-full

CORS_ALLOWED_ORIGINS=https://admin.example.com,https://shop.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-TOKEN,X-XSRF-TOKEN,X-Requested-With,Idempotency-Key,X-Tenant-Id
CORS_SUPPORTS_CREDENTIALS=true
SANCTUM_STATEFUL_DOMAINS=admin.example.com,shop.example.com
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=private-redis-host
REDIS_PASSWORD=replace-in-secret-manager
REDIS_PORT=6379
HEALTHCHECK_REDIS=true

LOG_CHANNEL=stack
LOG_LEVEL=notice
MAIL_MAILER=smtp
MAIL_HOST=replace-with-approved-mail-host
MAIL_PORT=587
MAIL_USERNAME=replace-in-secret-manager
MAIL_PASSWORD=replace-in-secret-manager
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="CIINLV POS"

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=replace-in-secret-manager
REVERB_APP_KEY=replace-in-secret-manager
REVERB_APP_SECRET=replace-in-secret-manager
REVERB_HOST=ws.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_ALLOWED_ORIGINS=https://admin.example.com,https://shop.example.com
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Keep unverified payment/refund/payout providers unset or disabled.
BACKUP_DIR=/var/backups/ciinlv-pos
BACKUP_ENCRYPTION_KEY=replace-in-secret-manager
BACKUP_DAILY_RETENTION_DAYS=14
BACKUP_WEEKLY_RETENTION_WEEKS=8
BACKUP_MONTHLY_RETENTION_MONTHS=12

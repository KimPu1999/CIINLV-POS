APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com
APP_FORCE_HTTPS=true
TRUSTED_PROXIES=REMOTE_ADDR
APP_KEY=provision-from-a-secret-manager

DB_CONNECTION=pgsql
DB_HOST=managed-postgres.internal
DB_PORT=5432
DB_DATABASE=ciinlv_pos
DB_USERNAME=ciinlv_runtime
DB_PASSWORD=provision-from-a-secret-manager
DB_SSLMODE=verify-full

CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-TOKEN,X-Requested-With,Idempotency-Key,X-Tenant-Id
CORS_SUPPORTS_CREDENTIALS=true
SANCTUM_STATEFUL_DOMAINS=app.example.com
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
CACHE_STORE=redis
HEALTHCHECK_REDIS=true

BACKUP_DIR=/var/backups/ciinlv-pos
BACKUP_ENCRYPTION_KEY=provision-from-a-secret-manager
BACKUP_DAILY_RETENTION_DAYS=14
BACKUP_WEEKLY_RETENTION_WEEKS=8
BACKUP_MONTHLY_RETENTION_MONTHS=12

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=provision-from-a-secret-manager
REVERB_APP_KEY=provision-from-a-secret-manager
REVERB_APP_SECRET=provision-from-a-secret-manager
REVERB_HOST=ws.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_ALLOWED_ORIGINS=https://app.example.com
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

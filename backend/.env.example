APP_NAME="CIINLV POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
AUTH_REQUIRE_VERIFIED_EMAIL=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ciinlv_pos
DB_USERNAME=ciinlv_user
DB_PASSWORD=replace-with-a-local-secret
DB_SSLMODE=prefer

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_SUPPORTS_CREDENTIALS=true
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
SANCTUM_MOBILE_TOKEN_DAYS=30
BUSINESS_INVITATION_EXPIRY_DAYS=7
# Trial businesses may create up to four branches; leave active/unlimited blank for no limit.
BUSINESS_TRIAL_BRANCH_LIMIT=4
BUSINESS_ACTIVE_BRANCH_LIMIT=
BUSINESS_PAST_DUE_BRANCH_LIMIT=0
BUSINESS_DEFAULT_BRANCH_LIMIT=

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

APP_NAME="CIINLV POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ciinlv_pos
DB_USERNAME=ciinlv_user
DB_PASSWORD=replace-with-a-local-secret
DB_SSLMODE=prefer

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

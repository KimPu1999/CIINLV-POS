APP_NAME="CIINLV POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
APP_FORCE_HTTPS=false
AUTH_REQUIRE_VERIFIED_EMAIL=false
EMAIL_VERIFICATION_EXPIRY_MINUTES=60
BUSINESS_REQUIRE_SUPER_ADMIN_APPROVAL=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ciinlv_pos
DB_USERNAME=ciinlv_user
DB_PASSWORD=replace-with-a-local-secret
DB_SSLMODE=prefer

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-TOKEN,X-XSRF-TOKEN,X-Requested-With,Idempotency-Key,X-Tenant-Id
CORS_SUPPORTS_CREDENTIALS=true
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,localhost:5173,127.0.0.1,localhost
SANCTUM_MOBILE_TOKEN_DAYS=30
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
BUSINESS_INVITATION_EXPIRY_HOURS=24
# Trial businesses may create up to four branches; leave active/unlimited blank for no limit.
BUSINESS_TRIAL_BRANCH_LIMIT=4
BUSINESS_ACTIVE_BRANCH_LIMIT=
BUSINESS_PAST_DUE_BRANCH_LIMIT=0
BUSINESS_DEFAULT_BRANCH_LIMIT=

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
# Set QUEUE_CONNECTION=database or redis in production so translation jobs run asynchronously.
TRANSLATION_DRIVER=none
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
TRANSLATION_API_TIMEOUT=15
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@ciinlv.local
MAIL_FROM_NAME="CIINLV POS"

# Real Gmail delivery (configure privately; never commit the app password):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=tls
# MAIL_USERNAME=your-gmail-address@gmail.com
# MAIL_PASSWORD=your-16-character-google-app-password
# MAIL_FROM_ADDRESS=your-gmail-address@gmail.com
# MAIL_FROM_NAME="CIINLV POS"
# For queued delivery, use database/redis and run a worker after configuring it.
CACHE_STORE=file
BROADCAST_CONNECTION=null
REVERB_APP_ID=local
REVERB_APP_KEY=replace-with-local-reverb-key
REVERB_APP_SECRET=replace-with-local-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
HEALTHCHECK_REDIS=false
API_RATE_LIMIT_PER_MINUTE=600
EXPORT_RATE_LIMIT_PER_MINUTE=10

# Backups are operational secrets; configure them outside committed source.
BACKUP_DIR=storage/app/private/backups
BACKUP_ENCRYPTION_KEY=replace-with-a-secret-manager-value
BACKUP_DAILY_RETENTION_DAYS=14
BACKUP_WEEKLY_RETENTION_WEEKS=8
BACKUP_MONTHLY_RETENTION_MONTHS=12
